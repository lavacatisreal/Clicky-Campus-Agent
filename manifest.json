{
  "manifest_version": 3,
  "name": "Clicky Campus Agent",
  "version": "1.0",
  "description": "校園 AI 語音虛擬游標測試",
  "icons": {
    "16": "assets/icons/campux-16.png",
    "32": "assets/icons/campux-32.png",
    "48": "assets/icons/campux-48.png",
    "128": "assets/icons/campux-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"], 
      "js": [
      "demoScripts.js",
      "content.js",
      "taskRunner.js",
      "planningOverlay.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  
  "host_permissions": [
    "http://localhost:3000/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["assets/icons/campux-128.png"],
      "matches": ["<all_urls>"]
    }
  ]
}