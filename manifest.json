{
  "manifest_version": 3,
  "name": "Clicky Campus Agent",
  "version": "1.0",
  "description": "校園 AI 語音虛擬游標測試",
  "permissions": [
    "activeTab",
    "scripting"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"], 
      "js": [
      "content.js",
      "planningOverlay.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  
  "host_permissions": [
    "http://localhost:3000/*"
  ]
}